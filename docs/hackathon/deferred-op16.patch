diff --git a/Assets/MarsOutpost/Tests/EditMode/OperationsExplorationTests.cs b/Assets/MarsOutpost/Tests/EditMode/OperationsExplorationTests.cs
new file mode 100644
index 0000000..e3f3aa5
--- /dev/null
+++ b/Assets/MarsOutpost/Tests/EditMode/OperationsExplorationTests.cs
@@ -0,0 +1,71 @@
+using System;
+using System.Linq;
+using NUnit.Framework;
+
+namespace MarsOutpost.Tests
+{
+    public class OperationsExplorationTests
+    {
+        private static MissionSimulation Create() => new MissionSimulation(
+            MissionConfig.CreateOperationsDefault(operationsSeed: 424242, enableOperationsRandomEvents: false),
+            new MissionScenario(events: Array.Empty<EventState>()));
+
+        private static GridCoord Frontier(MissionSimulation sim)
+        {
+            var map = sim.State.Map;
+            return map.Cells.First(c => !c.IsExplored && c.IsPassable &&
+                map.Config.GetCardinalNeighbors(c.Coord).Any(n => map.GetCell(n).IsExplored) &&
+                GridNav.TryFindPath(map, ParcelMap.AirlockCorridorCoord, c.Coord, out _, true)).Coord;
+        }
+
+        [Test]
+        public void ExplorationRequiresReachableFrontierAndRevealsOnlyAfterArrival()
+        {
+            var sim = Create();
+            var target = Frontier(sim);
+            var oldSnapshot = sim.State;
+            Assert.That(sim.AssignExploration("crew-1", new GridCoord(0, 0)).Success, Is.False);
+            Assert.That(sim.AssignExploration("crew-1", target).Success, Is.True);
+            Assert.That(sim.State.Map.GetCell(target).IsExplored, Is.False);
+            var job = sim.State.SurfaceJobs.Last();
+            sim.Tick(job.LegTotalDistance / job.TravelSpeed + 0.01);
+            Assert.That(sim.State.Map.GetCell(target).IsExplored, Is.True);
+            Assert.That(oldSnapshot.Map.GetCell(target).IsExplored, Is.False);
+            Assert.That(sim.AssignExploration("crew-2", target).Success, Is.False);
+        }
+
+        [Test]
+        public void ExplorationSaveAndLargeTickMatchSmallTicksAndRestart()
+        {
+            var big = Create();
+            var small = Create();
+            var target = Frontier(big);
+            Assert.That(big.AssignExploration("crew-1", target).Success, Is.True);
+            Assert.That(small.AssignExploration("crew-1", target).Success, Is.True);
+            big.Tick(0.5);
+            small.Tick(0.5);
+            Assert.That(MissionSimulation.TryLoadFromJson(big.SaveToJson(), out var loaded, out var error), Is.True, error);
+            big.Tick(100);
+            loaded.Tick(100);
+            for (int i = 0; i < 1000; i++) small.Tick(0.1);
+            for (int i = 0; i < big.State.Map.Cells.Count; i++)
+            {
+                Assert.That(loaded.State.Map.Cells[i].IsExplored, Is.EqualTo(big.State.Map.Cells[i].IsExplored));
+                Assert.That(small.State.Map.Cells[i].IsExplored, Is.EqualTo(big.State.Map.Cells[i].IsExplored));
+            }
+            big.Restart();
+            Assert.That(big.State.Map.GetCell(target).IsExplored, Is.False);
+        }
+
+        [Test]
+        public void CancellationBeforeArrivalDoesNotRevealTarget()
+        {
+            var sim = Create();
+            var target = Frontier(sim);
+            Assert.That(sim.AssignExploration("crew-1", target).Success, Is.True);
+            Assert.That(sim.CancelTask("crew-1").Success, Is.True);
+            sim.Tick(100);
+            Assert.That(sim.State.Map.GetCell(target).IsExplored, Is.False);
+        }
+    }
+}
